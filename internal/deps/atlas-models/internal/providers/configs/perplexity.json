{
  "name": "Perplexity Sonar (legacy compatibility)",
  "id": "perplexity",
  "type": "openai-compat",
  "api_key": "$PERPLEXITY_API_KEY",
  "api_endpoint": "https://api.perplexity.ai",
  "default_large_model_id": "sonar-reasoning-pro",
  "default_small_model_id": "sonar",
  "models": [
    {
      "id": "sonar-reasoning-pro",
      "name": "Sonar Reasoning Pro (search + reasoning)",
      "cost_per_1m_in": 1,
      "cost_per_1m_out": 5,
      "cost_per_1m_in_cached": 0,
      "cost_per_1m_out_cached": 0,
      "context_window": 128000,
      "default_max_tokens": 8192,
      "can_reason": true,
      "reasoning_levels": [
        "low",
        "medium",
        "high"
      ],
      "default_reasoning_effort": "medium",
      "supports_attachments": true
    },
    {
      "id": "sonar-pro",
      "name": "Sonar Pro (advanced search)",
      "cost_per_1m_in": 3,
      "cost_per_1m_out": 15,
      "cost_per_1m_in_cached": 0,
      "cost_per_1m_out_cached": 0,
      "context_window": 200000,
      "default_max_tokens": 8192,
      "can_reason": false,
      "supports_attachments": true
    },
    {
      "id": "sonar",
      "name": "Sonar (search, lightweight)",
      "cost_per_1m_in": 1,
      "cost_per_1m_out": 1,
      "cost_per_1m_in_cached": 0,
      "cost_per_1m_out_cached": 0,
      "context_window": 128000,
      "default_max_tokens": 8192,
      "can_reason": false,
      "supports_attachments": true
    }
  ]
}
