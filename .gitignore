# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories
vendor/

# Temp migration scripts. The leading-underscore patterns only ever
# matched a naming convention nobody followed, so the release and
# publishing scripts under scripts/ -- which carry live GitHub and npm
# tokens -- were never actually ignored.
_*.js
_*.py
scripts/*.js
scripts/*.py

# Build output (binaries live in npm/cli/binary/)
dist/

# Go workspace file
go.work
go.work.sum

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log

# Binary output directory
/bin/
/dist/

# Local environment variables
.env
.env.local

# Nix/direnv
.direnv/

**/.crush/**

/atlas
/tmp/

manpages/
completions/atlas.*sh
.prettierignore
.task

# Transient credential-helper file written by git during a push
.git-askpass-temp.cmd

# npm auth token, written by the release workflow next to the wrapper
# package and removed right after publish. Ignored so a failed or
# interrupted publish can never leave it stageable.
npm/cli/.npmrc
.npmrc
